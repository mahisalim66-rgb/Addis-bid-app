rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auctions are publicly readable by all users
    match /auctions/{auctionId} {
      allow read: if true;
      allow write: if true;
    }

    // Bids can be read and created
    match /bids/{bidId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Transactions (Telebirr deposit receipts)
    match /transactions/{transactionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Wallets & user balances
    match /wallets/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Platform settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
